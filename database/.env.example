# Names/placeholders only. Load secrets from your environment/secret manager.
# Never commit a populated .env file or put passwords in process arguments.
BANKOPS_POSTGRES_ADMIN_PASSWORD=replace-with-distinct-administrator-secret
BANKOPS_DB_ADMIN_DSN=host=127.0.0.1 port=5433 dbname=bankops user=bankops password=replace-with-administrator-secret
BANKOPS_DB_NAME=bankops
BANKOPS_DB_USER=bankops_runtime
BANKOPS_DB_PASSWORD=replace-with-distinct-runtime-secret-at-least-32-characters
BANKOPS_DB_URL=jdbc:postgresql://127.0.0.1:5433/bankops
BANKOPS_MIGRATION_DB_USER=bankops_migrator
BANKOPS_MIGRATION_DB_PASSWORD=replace-with-distinct-migration-secret-at-least-32-characters
BANKOPS_MIGRATION_DB_URL=jdbc:postgresql://127.0.0.1:5433/bankops
BANKOPS_RECONCILIATION_PASSWORD=replace-with-distinct-select-only-secret-at-least-32-characters
