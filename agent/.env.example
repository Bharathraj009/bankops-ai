BANKOPS_AGENT_ENVIRONMENT=dev
BANKOPS_AGENT_HOST=127.0.0.1
BANKOPS_AGENT_PORT=8000
BANKOPS_AGENT_LOG_LEVEL=INFO
BANKOPS_AGENT_PROMETHEUS_URL=http://localhost:9090
BANKOPS_AGENT_PROMETHEUS_TIMEOUT_SECONDS=5
BANKOPS_AGENT_INCIDENT_HTTP_ERROR_RATIO=0.05
BANKOPS_AGENT_INCIDENT_P95_SECONDS=1
BANKOPS_AGENT_INCIDENT_TRANSFER_FAILURE_RATE=0.05
BANKOPS_AGENT_INCIDENT_MIN_API_REQUEST_RATE=0.1
BANKOPS_AGENT_INCIDENT_MIN_TRANSFER_REQUEST_RATE=0.1
BANKOPS_AGENT_INCIDENT_MAX_EVIDENCE_AGE_SECONDS=60
BANKOPS_AGENT_JAEGER_URL=http://localhost:16686
BANKOPS_AGENT_JAEGER_TIMEOUT_SECONDS=5
BANKOPS_AGENT_JAEGER_WINDOW_SECONDS=300
BANKOPS_AGENT_JAEGER_MAX_TRACES=10
BANKOPS_AGENT_JAEGER_MAX_SPANS_PER_TRACE=100
BANKOPS_AGENT_JAEGER_MAX_TOTAL_SPANS=500
BANKOPS_AGENT_JAEGER_SLOW_SPAN_SECONDS=1
# Disabled unless an absolute, trusted local directory is explicitly supplied.
# BANKOPS_AGENT_LOG_SOURCE_DIRECTORY=C:\bankops-logs
BANKOPS_AGENT_LOG_SOURCE_FILENAME=banking.jsonl
BANKOPS_AGENT_LOG_WINDOW_SECONDS=300
BANKOPS_AGENT_LOG_MAX_EVENTS=100
BANKOPS_AGENT_LOG_MAX_BYTES=1048576
# Optional inference gateway; disabled until explicitly configured.
BANKOPS_AGENT_LLM_PROVIDER=disabled
# Alternative: openai_compatible (requires full chat endpoint, model and API key).
# BANKOPS_AGENT_LLM_URL=https://api.openai.com/v1/chat/completions
# BANKOPS_AGENT_LLM_URL=https://your-gateway.example/rca
# Supply BANKOPS_AGENT_LLM_API_KEY through your secret manager if required.
BANKOPS_AGENT_LLM_MODEL=rca
BANKOPS_AGENT_LLM_TIMEOUT_SECONDS=5
BANKOPS_AGENT_LLM_MAX_INPUT_BYTES=32768
BANKOPS_AGENT_LLM_MAX_OUTPUT_BYTES=16384
BANKOPS_AGENT_LLM_MAX_OUTPUT_TOKENS=512
# Groq requires false because its API does not support the store field.
BANKOPS_AGENT_LLM_CHAT_INCLUDE_STORE=true
# Human approval is disabled unless a private database path and distinct role hashes are supplied.
# BANKOPS_AGENT_APPROVAL_DB_PATH=C:\bankops-agent-data\approvals.sqlite3
# BANKOPS_AGENT_APPROVAL_PROPOSER_TOKEN_SHA256=<sha256 digest from secret manager>
# BANKOPS_AGENT_APPROVAL_REVIEWER_TOKEN_SHA256=<different sha256 digest; reviewer secret stays with human>
# Requires configured approvals and an authorized reviewer; only two read-only actions.
BANKOPS_AGENT_REMEDIATION_ENABLED=false
BANKOPS_AGENT_REMEDIATION_TIMEOUT_SECONDS=15
# Opt-in Airflow evidence. Supply a viewer/read-only bearer token externally.
BANKOPS_AGENT_AIRFLOW_ENABLED=false
BANKOPS_AGENT_AIRFLOW_URL=http://localhost:18081
# BANKOPS_AGENT_AIRFLOW_API_TOKEN=<read-only bearer token from secret manager>
BANKOPS_AGENT_AIRFLOW_TIMEOUT_SECONDS=5
BANKOPS_AGENT_AIRFLOW_WINDOW_SECONDS=172800
BANKOPS_AGENT_AIRFLOW_MAX_RUNS=5
