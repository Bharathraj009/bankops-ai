<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="com.bankops.banking.observability.SafeLogFilter"/>
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>${CONSOLE_LOG_STRUCTURED_FORMAT:-ecs}</format>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    <root level="OFF"><appender-ref ref="CONSOLE"/></root>
    <logger name="com.bankops.banking.observability" level="INFO"/>
</configuration>
