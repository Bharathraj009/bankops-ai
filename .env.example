# Root Compose infrastructure and separately provisioned application identities.
# See database/README.md; the unified launcher generates its own ignored settings.
BANKOPS_POSTGRES_ADMIN_PASSWORD=replace-with-distinct-administrator-secret
BANKOPS_DB_USER=bankops_runtime
BANKOPS_DB_PASSWORD=replace-with-distinct-runtime-secret-at-least-32-characters
BANKOPS_GRAFANA_ADMIN_USER=admin
BANKOPS_GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-strong-password
